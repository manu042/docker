HOST=0.0.0.0
PORT=3080

MONGO_URI=mongodb://mongodb:27017/LibreChat

DOMAIN_CLIENT='https://{{ librechat_url }}'
DOMAIN_SERVER='https://{{ librechat_url }}'

NO_INDEX=true
TRUST_PROXY=1


#===============#
# Debug Logging #
#===============#
DEBUG_LOGGING=false
DEBUG_CONSOLE=false


#===================================================#
#                     Endpoints                     #
#===================================================#
ENDPOINTS='{{ endpoints }}'


#============#
# Anthropic  #
#============#
ANTHROPIC_API_KEY='{{ anthropic_api_key }}'


#============#
# Google     #
#============#

# GOOGLE_KEY='{{ google_api_key }}'

# Gemini API (AI Studio)
# GOOGLE_MODELS=gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite-preview-06-17,gemini-2.0-flash,gemini-2.0-flash-lite

# GOOGLE_TITLE_MODEL=gemini-2.0-flash-lite-001

# GOOGLE_LOC=us-central1

# Google Safety Settings
# NOTE: These settings apply to both Vertex AI and Gemini API (AI Studio)
#
# For Vertex AI:
# To use the BLOCK_NONE setting, you need either:
# (a) Access through an allowlist via your Google account team, or
# (b) Switch to monthly invoiced billing: https://cloud.google.com/billing/docs/how-to/invoiced-billing
#
# For Gemini API (AI Studio):
# BLOCK_NONE is available by default, no special account requirements.
#
# Available options: BLOCK_NONE, BLOCK_ONLY_HIGH, BLOCK_MEDIUM_AND_ABOVE, BLOCK_LOW_AND_ABOVE
#
# GOOGLE_SAFETY_SEXUALLY_EXPLICIT=BLOCK_ONLY_HIGH
# GOOGLE_SAFETY_HATE_SPEECH=BLOCK_ONLY_HIGH
# GOOGLE_SAFETY_HARASSMENT=BLOCK_ONLY_HIGH
# GOOGLE_SAFETY_DANGEROUS_CONTENT=BLOCK_ONLY_HIGH
# GOOGLE_SAFETY_CIVIC_INTEGRITY=BLOCK_ONLY_HIGH


#============#
# OpenAI     #
#============#
OPENAI_API_KEY='{{ openai_api_key }}'

# TITLE_CONVO=false
# OPENAI_TITLE_MODEL=gpt-4o-mini

# OPENAI_SUMMARIZE=true
# OPENAI_SUMMARY_MODEL=gpt-4o-mini

# OPENAI_FORCE_PROMPT=true


#====================#
#   Assistants API   #
#====================#
ASSISTANTS_API_KEY='{{ openai_api_key }}'


#============#
# Plugins    #
#============#
DEBUG_PLUGINS={{ debug_plugins | default(true) }}

CREDS_KEY='{{ creds_key }}'
CREDS_IV='{{ creds_iv }}'


# Google
#-----------------
GOOGLE_SEARCH_API_KEY='{{ google_search_api_key }}'
GOOGLE_CSE_ID='{{ google_cse_id }}'


#==================================================#
#                      Search                      #
#==================================================#
SEARCH=true
MEILI_NO_ANALYTICS=true
MEILI_HOST=http://0.0.0.0:7700
MEILI_MASTER_KEY='{{ meili_master_key }}'


#==================================================#
#                        RAG                       #
#==================================================#
# More info: https://www.librechat.ai/docs/configuration/rag_api
RAG_OPENAI_API_KEY='{{ openai_api_key}}'
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small


#===================================================#
#                    User System                    #
#===================================================#

# Login and registration rate limiting
# ====================================
LOGIN_MAX=2
LOGIN_WINDOW=5
REGISTER_MAX=1
REGISTER_WINDOW=0

#========================#
# Registration and Login #
#========================#
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_ACCOUNT_DELETION=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true

SESSION_EXPIRY=1000 * 60 * 15
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 14

JWT_SECRET='{{ jwt_secret }}'
JWT_REFRESH_SECRET='{{ jwt_refresh_secret }}'

#========================#
# Shared Links           #
#========================#
ALLOW_SHARED_LINKS=false
ALLOW_SHARED_LINKS_PUBLIC=false

# RAG Service
#=========================================
RAG_API_URL=http://rag-api:8000

# Meilisearch Service
#=========================================
MEILI_MASTER_KEY='{{ meili_master_key }}'
MEILI_HOST=http://meilisearch:7700
