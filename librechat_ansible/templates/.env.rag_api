# ====== Retrieval-augmented generation (RAG) API Configuration ======
#
# More infos 
# - https://www.librechat.ai/docs/configuration/rag_api
# - https://github.com/danny-avila/rag_api

RAG_OPENAI_API_KEY='{{ openai_api_key }}'
JWT_SECRET='{{ jwt_secret }}'

RAG_API_URL=http://rag-api:8000
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
COLLECTION_NAME=librechat-collection

# === Vector DB config ===
DB_HOST=vectordb
POSTGRES_DB=file_embeddings_db
POSTGRES_USER='{{ postgres_user }}'
POSTGRES_PASSWORD='{{ postgres_pw }}'
